{
  "name": "student-performance-prediction",
  "version": "1.0.0",
  "private": true,
  "description": "Student Performance Prediction & Academic Risk Analysis System",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "migrate": "node server/db/migrate.js",
    "seed:admin": "node server/db/seed-admin.js",
    "seed:demo": "node server/db/seed-demo.js",
    "seed:metrics": "node server/db/seed-metrics.js",
    "setup:test-db": "node server/db/setup-test-db.js",
    "ml:train": "python ml-service/train_model.py",
    "ml:serve": "python -m uvicorn app:app --app-dir ml-service --port 8000",
    "test": "cross-env NODE_ENV=test DB_SCHEMA=student_performance_test ML_MOCK=true ML_TIMEOUT_MS=5000 jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 45000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/db/migrate.js",
      "!server/db/seed-*.js"
    ]
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
