# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Comma-separated list of additional origins allowed to call the API (CORS +
# manual origin guard). No wildcards; *.vercel.app is rejected. In production,
# include your Vercel frontend origin here (e.g. https://*.vercel.app is NOT
# allowed — list the exact origin). http://localhost:3000 is added automatically
# in non-production.
ALLOWED_ORIGINS=
# Alternative origin env vars (also merged into the allowlist).
CLIENT_ORIGIN=
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# PostgreSQL (InsForge) - server-side only. NEVER expose these to the browser.
# Prefer DATABASE_URL. The DB_* values are used as a fallback.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:********@tw3atypa.ap-southeast.database.insforge.app:5432/insforge?sslmode=require
DB_HOST=HOST
DB_PORT=5432
DB_NAME=insforge
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=require

# InsForge project API key (server-side only; the app does not send it to the browser)
INSFORGE_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-64-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
# Cookie SameSite attribute: 'lax' (default), 'strict', or 'none'.
# If 'none', secure=true is forced automatically.
COOKIE_SAMESITE=lax
# Set to 1 to enable Express trust proxy (e.g. behind a reverse proxy/load
# balancer). Automatically enabled when NODE_ENV=production.
TRUST_PROXY=

# Initial administrator, created with `npm run seed:admin`
ADMIN_EMAIL=admin@studentpredict.local
ADMIN_PASSWORD=Admin@123!
ADMIN_USERNAME=admin

# ---------------------------------------------------------------------------
# Python ML service
# ---------------------------------------------------------------------------
PYTHON_ML_URL=http://localhost:8000
# Set to true ONLY for local demos when the Python service is unavailable.
# Mock output is always labelled "MOCK - not real model output".
ML_MOCK=false
ML_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Test database (optional; falls back to a `test` schema on the main DB)
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
